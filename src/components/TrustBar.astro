---
import { GUARANTEE_LINE, trustBar } from '../data/marketplace';

interface Props {
  /** on-dark sits on the photo hero. on-light sits on the pro page. */
  tone?: 'on-dark' | 'on-light';
}

const { tone = 'on-dark' } = Astro.props;
---

<div class:list={['trust-bar', tone === 'on-light' && 'trust-bar--light']} role="list" aria-label="Trust">
  <div class="trust-bar__item" role="listitem">
    <span class="trust-bar__badge" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" width="16" height="16">
        <path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
        <path d="M8.5 12.2l2.2 2.2 4.8-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </span>
    <span class="trust-bar__strong">{trustBar.verifiedProLabel}</span>
  </div>
  <div class="trust-bar__item" role="listitem">
    <span class="trust-bar__strong" aria-label={`Star rating ${trustBar.starRating}, ${trustBar.reviewCount} reviews`}>
      ★ {trustBar.starRating}
    </span>
    <span class="trust-bar__meta">{trustBar.reviewCount} reviews</span>
  </div>
  <div class="trust-bar__item" role="listitem">
    <span class="trust-bar__strong">{trustBar.completedProjects}</span>
    <span class="trust-bar__meta">completed projects</span>
  </div>
  <div class="trust-bar__item trust-bar__item--guarantee" role="listitem">
    <span class="trust-bar__meta">Guarantee</span>
    <span class="trust-bar__strong">{GUARANTEE_LINE}</span>
  </div>
</div>

<style>
  .trust-bar {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    width: 100%;
    max-width: 920px;
    margin: 0 auto 22px;
    text-align: left;
  }
  .trust-bar__item {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2px;
    min-height: 64px;
    padding: 10px 12px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.22);
    color: #fff;
  }
  .trust-bar__item--guarantee {
    grid-column: 1 / -1;
  }
  .trust-bar__badge {
    display: inline-flex;
    width: 22px;
    height: 22px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: #0073e6;
    color: #fff;
    margin-bottom: 2px;
  }
  .trust-bar__strong {
    font-size: 13px;
    font-weight: 650;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }
  .trust-bar__meta {
    font-size: 11px;
    line-height: 1.35;
    color: rgba(255, 255, 255, 0.78);
  }
  .trust-bar--light .trust-bar__item {
    background: #fff;
    border-color: #dbe7f5;
    color: #141210;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
  }
  .trust-bar--light .trust-bar__meta {
    color: #5c6570;
  }
  @media (min-width: 768px) {
    .trust-bar {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .trust-bar__item--guarantee {
      grid-column: auto;
    }
  }
</style>
