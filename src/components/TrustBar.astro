---
import { trustBar } from '../data/marketplace';

interface Props {
  /** on-dark sits on the photo hero. on-light sits on the pro page. */
  tone?: 'on-dark' | 'on-light';
}

const { tone = 'on-dark' } = Astro.props;
---

<div class:list={['trust-bar', tone === 'on-light' && 'trust-bar--light']} role="list" aria-label="Trust">
  <div class="trust-bar__item" role="listitem">
    <span class="trust-bar__badge" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" width="14" height="14">
        <path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
        <path d="M8.5 12.2l2.2 2.2 4.8-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </span>
    <span class="trust-bar__strong">{trustBar.verifiedProLabel}</span>
  </div>
  <div class="trust-bar__item" role="listitem">
    <span class="trust-bar__strong" aria-label={`Star rating ${trustBar.starRating}, ${trustBar.reviewCount} reviews`}>★ {trustBar.starRating}</span>
    <span class="trust-bar__meta">{trustBar.reviewCount} reviews</span>
  </div>
  <div class="trust-bar__item" role="listitem">
    <span class="trust-bar__strong">{trustBar.completedProjects}</span>
    <span class="trust-bar__meta">completed projects</span>
  </div>
</div>

<style>
  .trust-bar {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 6px;
    width: 100%;
    max-width: 640px;
    margin: 14px auto 0;
    text-align: left;
  }
  .trust-bar__item {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1px;
    min-height: 0;
    padding: 7px 8px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.22);
    color: #fff;
  }
  .trust-bar__item:first-child {
    flex-direction: row;
    align-items: center;
    gap: 6px;
  }
  .trust-bar__badge {
    display: inline-flex;
    width: 18px;
    height: 18px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: #0073e6;
    color: #fff;
    flex-shrink: 0;
  }
  .trust-bar__strong {
    font-size: 12px;
    font-weight: 650;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .trust-bar__meta {
    font-size: 10px;
    line-height: 1.25;
    color: rgba(255, 255, 255, 0.78);
  }
  .trust-bar--light .trust-bar__item {
    background: #fff;
    border-color: #dbe7f5;
    color: #141210;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
  }
  .trust-bar--light .trust-bar__meta {
    color: #5c6570;
  }
</style>
