---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Post your project"
  description="A booking is confirmed only after you post a project and we match you with a pro."
  canonical="https://www.dealsofquality.com/booking-confirmed/"
  noindex={true}
>
  <main class="min-h-screen bg-background">
    <section class="pt-24 md:pt-32 pb-16 md:pb-24">
      <div class="container-max px-4">
        <div class="max-w-2xl mx-auto text-center">
          <h1 class="font-display text-4xl md:text-5xl font-bold text-foreground mb-4">
            Post your project to get matched
          </h1>
          <p class="text-lg text-muted-foreground mb-8">
            This page does not confirm a booking. Post your project and we’ll match you with a vetted pro.
          </p>
          <a href="/" class="inline-flex items-center justify-center rounded-xl h-12 px-8 text-base font-semibold bg-primary !text-white hover:bg-primary/90">
            Find your pro
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
