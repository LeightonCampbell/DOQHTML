---
import BaseLayout from '../../layouts/BaseLayout.astro';

const WINDOWS_DOWNLOAD = 'https://download.remotepc.com/downloads/OTA/RemotePCAttended.exe';
const MAC_DOWNLOAD = 'https://download.remotepc.com/downloads/OTA/RemotePCAttended.dmg';
---

<BaseLayout
  title="Remote Support | Get Instant Tech Help | Deals Of Quality"
  description="Get instant remote tech support from Deals of Quality. Download our secure remote support app and let our pros help you resolve computer issues fast."
  canonical="https://www.dealsofquality.com/remote-support/"
>
  <main class="flex-1">
    <section class="bg-gradient-to-br from-primary/10 via-background to-accent/5 section-padding">
      <div class="container-max">
        <div class="text-center max-w-3xl mx-auto">
          <div class="inline-flex items-center gap-2 px-4 py-2 bg-accent/10 text-accent rounded-full text-sm font-medium mb-6">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
            Instant Remote Assistance
          </div>
          <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-foreground mb-6">
            Remote Support
          </h1>
          <p class="text-lg md:text-xl text-muted-foreground mb-8">
            Get expert tech help from the comfort of your home. Our certified pros can securely connect to your computer and resolve issues in real-time.
          </p>

          <div id="rs-download" class="rs-hero-download">
            <label class="rs-download-consent">
              <input id="rs-consent" type="checkbox" checked />
              <span>I trust Deals of Quality and want to allow remote access to my computer for this support session.</span>
            </label>
            <p id="rs-mobile-note" class="rs-download-mobile-note" hidden>
              This app needs to run on a Windows PC or Mac. Open this page on the computer that needs help, or choose a download below.
            </p>
            <a
              class="rs-download-btn rs-primary-download"
              href={WINDOWS_DOWNLOAD}
              data-windows-href={WINDOWS_DOWNLOAD}
              data-mac-href={MAC_DOWNLOAD}
            >
              <svg class="rs-download-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
              </svg>
              <span class="rs-download-btn-copy">
                <span class="rs-download-btn-label">Download</span>
                <span class="rs-primary-os rs-download-btn-os">
                  <svg class="rs-os-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 5.5 10.2 4.4v6.7H3V5.5Zm7.2 7.3v6.8L3 18.5v-5.7h7.2ZM11.3 4.2 21 2.8v8.3h-9.7V4.2Zm9.7 8.9V21l-9.7-1.5v-6.4H21Z"/></svg>
                  for Windows
                </span>
              </span>
            </a>
            <p class="rs-download-alt">
              Also available for
              <a class="rs-alt-download" href={MAC_DOWNLOAD}>
                <svg class="rs-os-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.4 12.3c0-2.2 1.8-3.3 1.9-3.4-1.1-1.6-2.7-1.8-3.3-1.8-1.4-.1-2.7.8-3.4.8s-1.8-.8-3-.8c-1.5 0-3 .9-3.8 2.3-1.6 2.8-.4 7 1.2 9.3.8 1.1 1.7 2.3 2.9 2.3 1.2 0 1.6-.7 3-.7s1.8.7 3 .7 2-.1 2.9-2.3c.7-1 1.2-2 1.6-3.1-4.1-1.6-3.9-5.9-4-6.3ZM14.7 6.2c.6-.8 1.1-1.8.9-2.9-1 .1-2.1.7-2.8 1.5-.6.7-1.2 1.8-.9 2.8 1.1.1 2.1-.5 2.8-1.4Z"/></svg>
                Mac
              </a>
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="section-padding bg-muted/30">
      <div class="container-max">
        <div class="text-center mb-12">
          <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground mb-4">
            How It Works
          </h2>
          <p class="text-muted-foreground text-lg max-w-2xl mx-auto">
            Getting remote support is quick and easy. Follow these simple steps:
          </p>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="relative border border-border/50 rounded-xl bg-card p-6 text-center hover:border-primary/30 transition-colors">
            <div class="w-12 h-12 rounded-full bg-primary text-primary-foreground flex items-center justify-center text-xl font-bold mx-auto mb-4">1</div>
            <svg class="w-8 h-8 text-accent mx-auto mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
            <h3 class="font-display font-semibold text-foreground text-lg mb-2">Download the App</h3>
            <p class="text-muted-foreground text-sm">Click the download button to get the remote support app for your computer.</p>
          </div>
          <div class="relative border border-border/50 rounded-xl bg-card p-6 text-center hover:border-primary/30 transition-colors">
            <div class="w-12 h-12 rounded-full bg-primary text-primary-foreground flex items-center justify-center text-xl font-bold mx-auto mb-4">2</div>
            <svg class="w-8 h-8 text-accent mx-auto mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122" /></svg>
            <h3 class="font-display font-semibold text-foreground text-lg mb-2">Run the Application</h3>
            <p class="text-muted-foreground text-sm">Open the downloaded file and run the remote support app.</p>
          </div>
          <div class="relative border border-border/50 rounded-xl bg-card p-6 text-center hover:border-primary/30 transition-colors">
            <div class="w-12 h-12 rounded-full bg-primary text-primary-foreground flex items-center justify-center text-xl font-bold mx-auto mb-4">3</div>
            <svg class="w-8 h-8 text-accent mx-auto mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
            <h3 class="font-display font-semibold text-foreground text-lg mb-2">Share Your Code</h3>
            <p class="text-muted-foreground text-sm">A 9-digit session code will be generated. Share the code with us to allow us to connect to your computer.</p>
          </div>
          <div class="relative border border-border/50 rounded-xl bg-card p-6 text-center hover:border-primary/30 transition-colors">
            <div class="w-12 h-12 rounded-full bg-primary text-primary-foreground flex items-center justify-center text-xl font-bold mx-auto mb-4">4</div>
            <svg class="w-8 h-8 text-accent mx-auto mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
            <h3 class="font-display font-semibold text-foreground text-lg mb-2">Get Support</h3>
            <p class="text-muted-foreground text-sm">Your technician will connect securely and resolve your issue while you watch.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section-padding">
      <div class="container-max">
        <div class="grid lg:grid-cols-3 gap-8">
          <div class="flex items-start gap-4">
            <div class="w-14 h-14 rounded-xl bg-primary/10 flex items-center justify-center flex-shrink-0">
              <svg class="w-7 h-7 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
            </div>
            <div>
              <h3 class="font-display font-semibold text-foreground text-lg mb-2">Secure Connection</h3>
              <p class="text-muted-foreground">256-bit AES encryption ensures your data and privacy are protected throughout the session.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-14 h-14 rounded-xl bg-primary/10 flex items-center justify-center flex-shrink-0">
              <svg class="w-7 h-7 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
            </div>
            <div>
              <h3 class="font-display font-semibold text-foreground text-lg mb-2">Full Visibility</h3>
              <p class="text-muted-foreground">Watch everything your technician does on screen. You're always in control.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-14 h-14 rounded-xl bg-primary/10 flex items-center justify-center flex-shrink-0">
              <svg class="w-7 h-7 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <div>
              <h3 class="font-display font-semibold text-foreground text-lg mb-2">Fast Resolution</h3>
              <p class="text-muted-foreground">No waiting for a home visit. Get help in minutes from anywhere.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section-padding bg-primary/5">
      <div class="container-max">
        <div class="border border-primary/20 rounded-xl bg-card p-8 md:p-12 text-center max-w-4xl mx-auto">
          <h2 class="font-display text-2xl md:text-3xl font-bold text-foreground mb-4">
            Ready to Get Help?
          </h2>
          <p class="text-muted-foreground text-lg mb-8 max-w-2xl mx-auto">
            Download the remote support app and call us at <a href="tel:+18185847389" class="text-accent font-semibold hover:underline">(818) 584-7389</a> to start your session.
          </p>
          <div class="flex flex-col items-center gap-4">
            <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
              <a
                class="rs-download-btn rs-primary-download"
                href={WINDOWS_DOWNLOAD}
                data-windows-href={WINDOWS_DOWNLOAD}
                data-mac-href={MAC_DOWNLOAD}
              >
                <svg class="rs-download-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                <span class="rs-download-btn-copy">
                  <span class="rs-download-btn-label">Download</span>
                  <span class="rs-primary-os rs-download-btn-os">
                    <svg class="rs-os-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 5.5 10.2 4.4v6.7H3V5.5Zm7.2 7.3v6.8L3 18.5v-5.7h7.2ZM11.3 4.2 21 2.8v8.3h-9.7V4.2Zm9.7 8.9V21l-9.7-1.5v-6.4H21Z"/></svg>
                    for Windows
                  </span>
                </span>
              </a>
              <a href="tel:+18185847389" class="inline-flex items-center justify-center gap-2 rounded-md text-lg font-medium border border-input bg-background hover:bg-accent hover:text-accent-foreground h-12 px-8">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
                Call for Support
              </a>
            </div>
            <p class="rs-download-alt">
              Also available for
              <a class="rs-alt-download" href={MAC_DOWNLOAD}>
                <svg class="rs-os-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.4 12.3c0-2.2 1.8-3.3 1.9-3.4-1.1-1.6-2.7-1.8-3.3-1.8-1.4-.1-2.7.8-3.4.8s-1.8-.8-3-.8c-1.5 0-3 .9-3.8 2.3-1.6 2.8-.4 7 1.2 9.3.8 1.1 1.7 2.3 2.9 2.3 1.2 0 1.6-.7 3-.7s1.8.7 3 .7 2-.1 2.9-2.3c.7-1 1.2-2 1.6-3.1-4.1-1.6-3.9-5.9-4-6.3ZM14.7 6.2c.6-.8 1.1-1.8.9-2.9-1 .1-2.1.7-2.8 1.5-.6.7-1.2 1.8-.9 2.8 1.1.1 2.1-.5 2.8-1.4Z"/></svg>
                Mac
              </a>
            </p>
          </div>
          <div class="mt-8 pt-8 border-t border-border flex flex-wrap justify-center gap-6 text-sm text-muted-foreground">
            <span class="flex items-center gap-2"><svg class="w-4 h-4 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg> Fast, simple setup</span>
            <span class="flex items-center gap-2"><svg class="w-4 h-4 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg> Secure encrypted connection</span>
            <span class="flex items-center gap-2"><svg class="w-4 h-4 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg> Works on Windows & Mac</span>
          </div>
        </div>
      </div>
    </section>
  </main>

  <style is:global>
    .rs-hero-download {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: left;
    }
    .rs-download-consent {
      display: flex;
      align-items: flex-start;
      gap: 0.7rem;
      max-width: 420px;
      font-size: 0.95rem;
      line-height: 1.5;
      color: #374151;
      margin: 0 0 1.15rem;
      cursor: pointer;
    }
    .rs-download-consent input {
      margin-top: 0.2rem;
      width: 1.05rem;
      height: 1.05rem;
      accent-color: #0073e6;
      flex-shrink: 0;
    }
    .rs-download-mobile-note {
      max-width: 420px;
      background: #fff7ed;
      border: 1px solid #fde68a;
      color: #92400e;
      border-radius: 10px;
      padding: 0.75rem 0.9rem;
      margin: 0 0 1rem;
      font-size: 0.9rem;
    }
    #main-content .rs-download-btn {
      display: flex !important;
      align-items: center;
      gap: 0.9rem;
      width: 100%;
      max-width: 320px;
      background: #0073e6;
      color: #fff !important;
      text-decoration: none !important;
      border-radius: 12px;
      padding: 0.95rem 1.2rem;
      margin: 0 0 0.85rem;
      box-shadow: 0 8px 20px rgba(0, 115, 230, 0.28);
      transition: background 0.2s, transform 0.15s, opacity 0.2s;
    }
    #main-content .rs-download-btn:hover {
      background: #0062cc;
      color: #fff !important;
      transform: translateY(-1px);
    }
    #main-content .rs-download-btn.is-disabled {
      pointer-events: none;
      opacity: 0.45;
    }
    .rs-download-arrow {
      width: 28px;
      height: 28px;
      flex-shrink: 0;
    }
    .rs-download-btn-copy {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      line-height: 1.2;
    }
    .rs-download-btn-label {
      font-size: 1.35rem;
      font-weight: 700;
    }
    .rs-download-btn-os {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      font-size: 0.85rem;
      font-weight: 500;
      opacity: 0.95;
    }
    .rs-os-icon {
      width: 13px;
      height: 13px;
    }
    .rs-download-alt {
      font-size: 0.95rem;
      color: #4b5563;
      margin: 0;
    }
    #main-content .rs-download-alt a {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      color: #0073e6;
      font-weight: 600;
      text-decoration: none;
    }
    #main-content .rs-download-alt a:hover {
      text-decoration: underline;
    }
    #main-content .rs-download-alt a.is-disabled {
      pointer-events: none;
      opacity: 0.45;
    }
    @media (max-width: 480px) {
      #main-content .rs-download-btn {
        max-width: none;
      }
    }
  </style>

  <script is:inline>
    (function () {
      var WIN_ICON = '<svg class="rs-os-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 5.5 10.2 4.4v6.7H3V5.5Zm7.2 7.3v6.8L3 18.5v-5.7h7.2ZM11.3 4.2 21 2.8v8.3h-9.7V4.2Zm9.7 8.9V21l-9.7-1.5v-6.4H21Z"/></svg>';
      var MAC_ICON = '<svg class="rs-os-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.4 12.3c0-2.2 1.8-3.3 1.9-3.4-1.1-1.6-2.7-1.8-3.3-1.8-1.4-.1-2.7.8-3.4.8s-1.8-.8-3-.8c-1.5 0-3 .9-3.8 2.3-1.6 2.8-.4 7 1.2 9.3.8 1.1 1.7 2.3 2.9 2.3 1.2 0 1.6-.7 3-.7s1.8.7 3 .7 2-.1 2.9-2.3c.7-1 1.2-2 1.6-3.1-4.1-1.6-3.9-5.9-4-6.3ZM14.7 6.2c.6-.8 1.1-1.8.9-2.9-1 .1-2.1.7-2.8 1.5-.6.7-1.2 1.8-.9 2.8 1.1.1 2.1-.5 2.8-1.4Z"/></svg>';

      function detectOS() {
        var ua = navigator.userAgent || '';
        var platform = navigator.platform || '';
        var hints = navigator.userAgentData && navigator.userAgentData.platform
          ? String(navigator.userAgentData.platform).toLowerCase()
          : '';
        var isIPad = /iPad/.test(ua) || (platform === 'MacIntel' && navigator.maxTouchPoints > 1);
        if (/Android|iPhone|iPod/.test(ua) || isIPad) return 'mobile';
        if (hints.indexOf('mac') !== -1 || /Mac/.test(platform) || /Mac OS X/.test(ua)) return 'mac';
        if (hints.indexOf('win') !== -1 || /Win/.test(platform) || /Windows/.test(ua)) return 'windows';
        return 'windows';
      }

      var os = detectOS();
      var primaries = document.querySelectorAll('.rs-primary-download');
      var primaryOsLabels = document.querySelectorAll('.rs-primary-os');
      var alts = document.querySelectorAll('.rs-alt-download');
      var mobileNote = document.getElementById('rs-mobile-note');
      var consent = document.getElementById('rs-consent');
      if (!primaries.length || !alts.length || !consent) return;

      var windowsHref = primaries[0].getAttribute('data-windows-href');
      var macHref = primaries[0].getAttribute('data-mac-href');

      primaries.forEach(function (primary, i) {
        var label = primaryOsLabels[i];
        if (os === 'mac') {
          primary.href = macHref;
          if (label) label.innerHTML = MAC_ICON + ' for Mac';
        } else {
          primary.href = windowsHref;
          if (label) label.innerHTML = WIN_ICON + ' for Windows';
        }
      });

      alts.forEach(function (alt) {
        if (os === 'mac') {
          alt.href = windowsHref;
          alt.innerHTML = WIN_ICON + ' Windows';
        } else {
          alt.href = macHref;
          alt.innerHTML = MAC_ICON + ' Mac';
        }
      });

      if (os === 'mobile' && mobileNote) {
        mobileNote.hidden = false;
      }

      function syncConsent() {
        var allowed = consent.checked;
        primaries.forEach(function (primary) {
          primary.classList.toggle('is-disabled', !allowed);
          primary.setAttribute('aria-disabled', allowed ? 'false' : 'true');
        });
        alts.forEach(function (alt) {
          alt.classList.toggle('is-disabled', !allowed);
          alt.setAttribute('aria-disabled', allowed ? 'false' : 'true');
        });
      }
      consent.addEventListener('change', syncConsent);
      syncConsent();
    })();
  </script>
</BaseLayout>
