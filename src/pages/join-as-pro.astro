---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProApplicationForm from '../components/ProApplicationForm.astro';
import TrustBar from '../components/TrustBar.astro';
import { GUARANTEE_LINE } from '../data/marketplace';

const steps = [
  { n: '1', title: 'Apply and get verified', text: 'Apply and get verified with your license and insurance.' },
  { n: '2', title: 'Get matched', text: 'Get matched to jobs in your trade and area.' },
  { n: '3', title: 'Win the work', text: 'Win the work and build your rating.' },
];
---

<BaseLayout
  title="Get real jobs from homeowners ready to hire"
  description="Homeowners post a project and Deals of Quality matches it to vetted pros. Apply with your license and insurance, then spend your time on the work."
  canonical="https://www.dealsofquality.com/join-as-pro/"
>
  <main class="min-h-screen bg-background">
    <section class="relative bg-gradient-to-br from-primary/5 via-background to-primary/10 pt-24 md:pt-28 pb-16 overflow-hidden">
      <div class="container-max px-4 md:px-8 relative z-10">
        <TrustBar tone="on-light" />
        <div class="max-w-3xl mx-auto text-center">
          <p class="text-primary font-semibold mb-3 uppercase tracking-wide text-sm">For pros</p>
          <h1 class="text-4xl md:text-5xl lg:text-[3.4rem] font-bold text-foreground leading-tight mb-5">
            Get real jobs from homeowners ready to hire.
          </h1>
          <p class="text-lg md:text-xl text-muted-foreground mb-8">
            Homeowners post a project, we match it to vetted pros like you, and you spend your time on the work instead of chasing leads.
          </p>
          <a href="#join-as-a-pro" class="inline-flex items-center justify-center rounded-xl h-12 px-8 text-base font-semibold bg-primary !text-white hover:bg-primary/90 shadow-lg transition-all">
            Get jobs
          </a>
          <p class="mt-4 text-sm text-muted-foreground">We vet every pro, and that's why homeowners trust the match.</p>
        </div>
        <ol class="pro-steps">
          {steps.map((step) => (
            <li>
              <span>{step.n}</span>
              <strong>{step.title}</strong>
              <p>{step.text}</p>
            </li>
          ))}
        </ol>
        <p class="text-center text-sm font-semibold text-[#0B3A66] mt-6">{GUARANTEE_LINE}</p>
      </div>
    </section>

    <ProApplicationForm />
  </main>
</BaseLayout>

<style>
  .pro-steps {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    margin: 36px auto 0;
    padding: 0;
    max-width: 920px;
    text-align: left;
  }
  .pro-steps li {
    position: relative;
    padding: 16px 16px 16px 56px;
    border: 1px solid #dbe7f5;
    border-radius: 14px;
    background: #fff;
  }
  .pro-steps li span {
    position: absolute;
    left: 14px;
    top: 16px;
    width: 28px;
    height: 28px;
    border-radius: 999px;
    background: #0073e6;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
  }
  .pro-steps li strong { display: block; margin-bottom: 4px; color: #141210; }
  .pro-steps li p { margin: 0; color: #5c6570; font-size: 14px; line-height: 1.45; }
  @media (min-width: 768px) {
    .pro-steps { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
