# Resend — https://resend.com
# Set these on the Cloudflare Pages project (doqhtml). Do not commit real values.
RESEND_API_KEY=
# Verified sender, for example: Deals of Quality <notifications@dealsofquality.com>
RESEND_FROM=
# Inbox that receives project, pro, and contact submissions
NOTIFY_EMAIL_TO=

# Discord notification (default channel)
DISCORD_WEBHOOK_URL=

# Switch the notifier without a code change:
# NOTIFY_CHANNEL=discord
# NOTIFY_CHANNEL=telegram
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Local form checks only. Never set this on production.
# NOTIFY_DRY_RUN=1
# A RESEND_API_KEY value of "test" also skips outbound email and chat notifications.

# Older names still accepted if the new ones are empty:
# FROM_EMAIL=
# NOTIFICATION_EMAIL=
